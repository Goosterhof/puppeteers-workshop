# The heavy machinery — upstream clones with venvs + ~120 GB of model weights.
# They are installed onto the workshop floor, never tracked. runbook.md
# documents how to bolt them down again from scratch.
/Wan2GP/
/ComfyUI/
/MMAudio/
# FFmpeg SHARED libraries (BtbN build) — torchcodec's substrate; the static
# binaries in ~/.local/bin carry no .so files. Re-bolt per the runbook.
/ffmpeg-shared/

# The footage archive — personal media (the puppeteer's own face among it).
# Never leaves the building.
/footage/

# Ephemera of running the machines.
*.log
/jobs/logs/
/outputs/
__pycache__/
/jobs/prompter-*.json
/jobs/kiln-*.json

# The Kiln Room's working shelves — candidates cure and pack on the bench,
# never in the blueprint. The Scientist's pack step carries approved pairs
# into town-sketches by hand (experiment log #00062's artifact geography).
/prompter-box/kiln-output/
/prompter-box/pack-queue/
/prompter-box/night-shift-queue.json
/prompter-box/tests/__pycache__/
.pytest_cache/
