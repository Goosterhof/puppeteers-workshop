{
    "name": "prompter-box-front",
    "version": "0.1.0",
    "private": true,
    "description": "The Proscenium — the Prompter's Box front as a Vue 3 + UnoCSS + Vite application (experiment log #00063). Builds into ../static/booth/; the stdlib Python server serves the bundle, Node is a development-time tool only.",
    "type": "module",
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "check:dist": "npm run build && node scripts/check-dist.mjs",
        "dev": "vite",
        "lint": "oxlint",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json --composite false"
    },
    "dependencies": {
        "@script-development/ui-inputs": "^0.17.4",
        "three": "^0.187.0",
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/three": "^0.187.0",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/coverage-v8": "^5.1.1",
        "@vue/test-utils": "^2.6.0",
        "jsdom": "^31.0.1",
        "oxlint": "^1.94.0",
        "playwright-core": "^1.65.1",
        "typescript": "~6.0.3",
        "unocss": "^66.13.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    }
}
