{
    "name": "prompter-box-front",
    "version": "0.1.0",
    "private": true,
    "description": "The Proscenium — the Prompter's Box front as a Vue 3 + UnoCSS + Vite application (experiment log #00063). Builds into ../static/booth/; the stdlib Python server serves the bundle, Node is a development-time tool only.",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "check:dist": "vite build && node scripts/check-dist.mjs",
        "dev": "vite",
        "lint": "oxlint",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "three": "^0.177.0",
        "vue": "^3.5.39"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^29.1.1",
        "oxlint": "^1.68.0",
        "playwright-core": "^1.61.1",
        "unocss": "^66.7.4",
        "vite": "^8.1.3",
        "vitest": "^4.1.10"
    }
}
