{
    "name": "prompter-box-front",
    "version": "0.1.0",
    "private": true,
    "description": "The Proscenium — the Prompter's Box front as a Vue 3 + UnoCSS + Vite application (experiment log #00063). Builds into ../static/booth/; the stdlib Python server serves the bundle, Node is a development-time tool only.",
    "type": "module",
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "check:dist": "npm run build && node scripts/check-dist.mjs",
        "dev": "vite",
        "lint": "oxlint",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json --composite false"
    },
    "dependencies": {
        "@script-development/ui-inputs": "^0.17.1",
        "three": "^0.186.1",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "^30.1.3",
        "oxlint": "^1.88.0",
        "playwright-core": "^1.64.1",
        "typescript": "~7.0.2",
        "unocss": "^66.11.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    }
}
